{
    "name": "AI News Summarizer to Notion/Gmail (Upstage Solar)",
    "nodes": [
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "field": "cronExpression",
                            "expression": "0 9 * * *"
                        }
                    ]
                }
            },
            "id": "1",
            "name": "Schedule Trigger",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1.1,
            "position": [
                100,
                300
            ]
        },
        {
            "parameters": {
                "url": "https://news.google.com/rss/search?q=인공지능+OR+AI+when:24h&hl=ko&gl=KR&ceid=KR:ko"
            },
            "id": "2",
            "name": "RSS Feed Read",
            "type": "n8n-nodes-base.rssFeedRead",
            "typeVersion": 1,
            "position": [
                300,
                300
            ]
        },
        {
            "parameters": {
                "operation": "limit",
                "maxItems": 3
            },
            "id": "3",
            "name": "Limit Items",
            "type": "n8n-nodes-base.itemLists",
            "typeVersion": 1,
            "position": [
                500,
                300
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://api.upstage.ai/v1/solar/chat/completions",
                "authentication": "genericCredentialType",
                "genericAuthType": "httpHeaderAuth",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "bodyParameters": {
                    "parameters": [
                        {
                            "name": "model",
                            "value": "solar-1-mini-chat"
                        },
                        {
                            "name": "messages",
                            "value": "={{ [{\n  \"role\": \"user\",\n  \"content\": \"다음 기사 내용을 바탕으로 핵심만 3줄로 요약해줘.\\\\n제목: \" + $json.title + \"\\\\n링크: \" + $json.link\n}] }}"
                        }
                    ]
                },
                "options": {}
            },
            "id": "4",
            "name": "Upstage Solar",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.1,
            "position": [
                700,
                300
            ]
        },
        {
            "parameters": {
                "resource": "databasePage",
                "operation": "create",
                "databaseId": {
                    "__rl": true,
                    "value": "YOUR_NOTION_DATABASE_ID",
                    "mode": "id"
                },
                "propertiesUi": {
                    "propertyValues": [
                        {
                            "key": "Name|title",
                            "title": "={{ $node[\"RSS Feed Read\"].json[\"title\"] }}"
                        },
                        {
                            "key": "Summary|rich_text",
                            "richTextValue": "={{ $json.choices[0].message.content }}"
                        },
                        {
                            "key": "Link|url",
                            "urlValue": "={{ $node[\"RSS Feed Read\"].json[\"link\"] }}"
                        }
                    ]
                }
            },
            "id": "5",
            "name": "Notion",
            "type": "n8n-nodes-base.notion",
            "typeVersion": 2,
            "position": [
                900,
                200
            ]
        },
        {
            "parameters": {
                "sendTo": "your.email@gmail.com",
                "subject": "={{ '[AI 요약] ' + $node[\"RSS Feed Read\"].json[\"title\"] }}",
                "message": "={{ $node[\"Upstage Solar\"].json.choices[0].message.content + '\\n\\n원문 링크: ' + $node[\"RSS Feed Read\"].json[\"link\"] }}"
            },
            "id": "6",
            "name": "Gmail",
            "type": "n8n-nodes-base.gmail",
            "typeVersion": 2.1,
            "position": [
                900,
                400
            ]
        }
    ],
    "connections": {
        "Schedule Trigger": {
            "main": [
                [
                    {
                        "node": "RSS Feed Read",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "RSS Feed Read": {
            "main": [
                [
                    {
                        "node": "Limit Items",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Limit Items": {
            "main": [
                [
                    {
                        "node": "Upstage Solar",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Upstage Solar": {
            "main": [
                [
                    {
                        "node": "Notion",
                        "type": "main",
                        "index": 0
                    },
                    {
                        "node": "Gmail",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}